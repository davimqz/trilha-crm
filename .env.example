# Copie para .env e ajuste. Nunca commite o .env.
DATABASE_URL=postgres://trilha:trilha_dev@localhost:5432/trilha_crm
TEST_DATABASE_URL=postgres://trilha:trilha_dev@localhost:5432/trilha_crm_test

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Produção (Netlify + Neon) — ver docs/deployment.md
# DATABASE_URL = URL com "-pooler" (app); DATABASE_URL_UNPOOLED = URL direta (migrations)
# DATABASE_URL_UNPOOLED=
# Cabeçalho com o IP real do cliente. Obrigatório em produção (Netlify: x-nf-client-connection-ip)
# AUTH_IP_HEADER=
